{
    "name":  "proofpass-midnight-dapp",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=22.0.0"
                },
    "scripts":  {
                    "compile":  "compact compile contracts/proofpass.compact contracts/managed/proofpass",
                    "test":  "cross-env NODE_OPTIONS=\u0027--experimental-vm-modules\u0027 vitest run src/test/contract.unit.test.ts",
                    "test:integration":  "cross-env NODE_OPTIONS=\u0027--experimental-vm-modules\u0027 vitest run src/test/proofpass.test.ts",
                    "test:local":  "cross-env MIDNIGHT_NETWORK=local yarn test:integration",
                    "test:preview":  "cross-env MIDNIGHT_NETWORK=preview yarn test:integration",
                    "test:preprod":  "cross-env MIDNIGHT_NETWORK=preprod yarn test:integration",
                    "env:up":  "docker compose up -d --wait",
                    "env:down":  "docker compose down",
                    "copy:managed":  "xcopy /E /I /Y contracts\\managed\\proofpass\\contract frontend\\src\\managed\\contract \u0026\u0026 xcopy /E /I /Y contracts\\managed\\proofpass frontend\\public\\managed",
                    "test:unit":  "vitest run src/test/contract.unit.test.ts",
                    "verify:env":  "tsx scripts/verify-local.ts"
                },
    "dependencies":  {
                         "@midnight-ntwrk/midnight-js-contracts":  "4.1.1",
                         "@midnight-ntwrk/midnight-js-http-client-proof-provider":  "4.1.1",
                         "@midnight-ntwrk/midnight-js-indexer-public-data-provider":  "4.1.1",
                         "@midnight-ntwrk/midnight-js-level-private-state-provider":  "4.1.1",
                         "@midnight-ntwrk/midnight-js-node-zk-config-provider":  "4.1.1",
                         "@midnight-ntwrk/midnight-js-protocol":  "4.1.1",
                         "@midnight-ntwrk/testkit-js":  "4.1.1",
                         "@midnight-ntwrk/wallet-sdk":  "1.0.0",
                         "pino":  "^9.0.0",
                         "pino-pretty":  "^13.0.0",
                         "rxjs":  "^7.8.2",
                         "ws":  "^8.14.2"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.0.0",
                            "@types/ws":  "^8.5.9",
                            "cross-env":  "^10.1.0",
                            "typescript":  "^5.7.0",
                            "vitest":  "^4.1.0"
                        },
    "resolutions":  {
                        "@midnight-ntwrk/ledger-v8":  "8.1.2"
                    },
    "packageManager":  "yarn@1.22.22"
}
