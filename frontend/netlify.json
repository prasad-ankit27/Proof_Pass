{
  "$schema": "https://json.schemastore.org/netlify.json",
  "build": {
    "publish": "dist",
    "command": "yarn build",
    "environment": {
      "NODE_VERSION": "20"
    }
  },
  "redirects": [
    {
      "from": "/*",
      "to": "/index.html",
      "status": 200,
      "force": false
    }
  ],
  "headers": [
    {
      "for": "/*",
      "values": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "credentialless"
      }
    },
    {
      "for": "/managed/*",
      "values": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "for": "/assets/*.wasm",
      "values": {
        "Content-Type": "application/wasm",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  ]
}
