/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/managed/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Access-Control-Allow-Origin: *

/assets/*.wasm
  Content-Type: application/wasm
  Cross-Origin-Embedder-Policy: require-corp
